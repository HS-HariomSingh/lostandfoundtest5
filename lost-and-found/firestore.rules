rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == studentId || isAdmin());
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if resource.data.status == 'approved' || (isSignedIn() && (resource.data.student_id == request.auth.uid || isAdmin()));
      allow create: if isSignedIn() && isValidId(itemId);
      allow update: if isSignedIn() && (resource.data.student_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.student_id == request.auth.uid);
    }

    match /item_claims/{claimId} {
      allow read: if isSignedIn() && (resource.data.student_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(claimId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}

{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student user profile registered in campus lost and found",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique student identifier"
        },
        "student_id": {
          "type": "string",
          "description": "Student roll or college ID card number"
        },
        "name": {
          "type": "string",
          "description": "Full name of the student"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Campus college email address"
        },
        "password_hash": {
          "type": "string",
          "description": "Hashed student password"
        },
        "department": {
          "type": "string",
          "description": "Academic department or faculty"
        },
        "phone": {
          "type": "string",
          "description": "Student contact phone number"
        },
        "role": {
          "type": "string",
          "enum": ["student"],
          "description": "User role in the system"
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        }
      },
      "required": ["id", "student_id", "name", "email", "password_hash", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Campus security and administrator profile",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique administrator document identifier"
        },
        "admin_id": {
          "type": "string",
          "description": "Official campus administration ID"
        },
        "name": {
          "type": "string",
          "description": "Name or office designation"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Official administrator email"
        },
        "password_hash": {
          "type": "string",
          "description": "Hashed administrator password"
        },
        "office_location": {
          "type": "string",
          "description": "Physical room or building on campus"
        },
        "phone": {
          "type": "string",
          "description": "Official office contact phone"
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Administrator role designation"
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        }
      },
      "required": ["id", "admin_id", "name", "email", "password_hash", "role"]
    },
    "Item": {
      "title": "Item",
      "description": "Report of a lost or found item on campus",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique item document identifier"
        },
        "title": {
          "type": "string",
          "description": "Title or headline of the item"
        },
        "type": {
          "type": "string",
          "enum": ["lost", "found"],
          "description": "Type of report"
        },
        "category": {
          "type": "string",
          "description": "Item category"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the item"
        },
        "location": {
          "type": "string",
          "description": "Campus location where lost or found"
        },
        "date": {
          "type": "string",
          "description": "Date incident occurred in YYYY-MM-DD"
        },
        "image_url": {
          "type": "string",
          "description": "Optional URL to image photo of item"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "claimed", "resolved"],
          "description": "Current workflow status of the report"
        },
        "student_id": {
          "type": "string",
          "description": "Identifier of reporting student"
        },
        "student_name": {
          "type": "string",
          "description": "Name of reporting student"
        },
        "student_email": {
          "type": "string",
          "description": "Email of reporting student"
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        }
      },
      "required": ["id", "title", "type", "category", "description", "location", "date", "status"]
    },
    "ItemClaim": {
      "title": "ItemClaim",
      "description": "Claim filed by student to claim a found item",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique claim document identifier"
        },
        "item_id": {
          "type": "string",
          "description": "Reference ID of the found item"
        },
        "item_title": {
          "type": "string",
          "description": "Title of the found item"
        },
        "student_id": {
          "type": "string",
          "description": "Reference ID of the claimant student"
        },
        "student_name": {
          "type": "string",
          "description": "Name of the claimant student"
        },
        "student_email": {
          "type": "string",
          "description": "Email of the claimant student"
        },
        "proof_description": {
          "type": "string",
          "description": "Proof of ownership and distinguishing details"
        },
        "contact_phone": {
          "type": "string",
          "description": "Phone number to coordinate item pickup"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Administrative review status of the claim"
        },
        "created_at": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        }
      },
      "required": ["id", "item_id", "student_id", "proof_description", "contact_phone", "status"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of student profiles"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Collection of administrator profiles"
    },
    "/items/{itemId}": {
      "schema": "Item",
      "description": "Collection of lost and found item reports"
    },
    "/item_claims/{claimId}": {
      "schema": "ItemClaim",
      "description": "Collection of claims submitted by students"
    }
  }
}

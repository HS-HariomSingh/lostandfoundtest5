# Aiven MySQL Connection Settings
# Found in Aiven Console -> Service Overview -> Connection Information

# Option 1: Full Service URI (Recommended)
AIVEN_MYSQL_URL=mysql://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST.aivencloud.com:24032/lostandfound_db?ssl-mode=REQUIRED

# Option 2: Individual Connection Parameters
AIVEN_MYSQL_HOST=YOUR_AIVEN_HOST.aivencloud.com
AIVEN_MYSQL_PORT=24032
AIVEN_MYSQL_USER=avnadmin
AIVEN_MYSQL_PASSWORD=YOUR_AIVEN_PASSWORD
AIVEN_MYSQL_DATABASE=lostandfound_db
AIVEN_MYSQL_SSL_MODE=REQUIRED

# Optional: Path to CA certificate (if custom CA validation is required)
# AIVEN_MYSQL_CA_PATH=./database/ca.pem
# Set to false only during quick development testing if self-signed cert
AIVEN_MYSQL_REJECT_UNAUTHORIZED=true

# Campus Lost and Found - Aiven MySQL Database Configuration
# Direct connection URI or individual parameters:
AIVEN_MYSQL_URL="mysql://avnadmin:YOUR_AIVEN_PASSWORD@YOUR_AIVEN_HOST.aivencloud.com:14526/defaultdb?ssl-mode=REQUIRED"
AIVEN_MYSQL_HOST="YOUR_AIVEN_HOST.aivencloud.com"
AIVEN_MYSQL_PORT="14526"
AIVEN_MYSQL_USER="avnadmin"
AIVEN_MYSQL_PASSWORD="YOUR_AIVEN_PASSWORD"
AIVEN_MYSQL_DATABASE="defaultdb"
AIVEN_MYSQL_SSL_MODE="REQUIRED"
AIVEN_MYSQL_REJECT_UNAUTHORIZED="true"

# Application Session Secret
SESSION_SECRET="your-session-secret-here"
PORT="3000"
